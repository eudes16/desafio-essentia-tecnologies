## Environment variables for the API application
APP_VERSION=1.0.0
APP_NAME=todo-app
APP_HOST=localhost
APP_PORT=4000

APP_JWT_SECRET=abcd1234
APP_JWT_EXPIRATION=1d

APP_DB_HOST=SEU_HOST_DO_BANCO_DE_DADOS
APP_DB_PORT=PORTA_DO_BANCO_DE_DADOS
APP_DB_USER=USUARIO_DO_BANCO_DE_DADOS
APP_DB_PASSWORD=SUA_SENHA_DO_BANCO_DE_DADOS
APP_DB_NAME=NOME_DO_BANCO_DE_DADOS

DATABASE_URL="mysql://${APP_DB_USER}:${APP_DB_PASSWORD}@${APP_DB_HOST}:${APP_DB_PORT}/${APP_DB_NAME}"

ERROR_LOG="query, error"